{
  "name": "huggingface-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-docs.mjs",
    "split": "python3 scripts/split-from-full.py",
    "translate": "node scripts/translate-docs.mjs",
    "translate:smoke": "TRANSLATE_LIMIT=10 node scripts/translate-docs.mjs",
    "build": "node scripts/build-site.mjs",
    "build:pages": "PAGES_BASE=/huggingface-docs node scripts/build-site.mjs"
  },
  "devDependencies": {
    "marked": "^15.0.0"
  }
}
